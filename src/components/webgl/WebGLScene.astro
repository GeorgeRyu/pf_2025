---
export interface Props {
    movies?: string[];
    playgroundMovies?: string[];
    photos?: string[];
}
const { movies = [], playgroundMovies = [], photos = [] } = Astro.props;
const moviesAttr = encodeURIComponent(JSON.stringify(movies));
const playgroundMoviesAttr = encodeURIComponent(JSON.stringify(playgroundMovies));
const photosAttr = encodeURIComponent(JSON.stringify(photos));
---

<div
	id="webgl-container"
	class="relative z-10"
	style="opacity: 0"
	data-movies={moviesAttr}
	data-playground-movies={playgroundMoviesAttr}
	data-photos={photosAttr}
></div>

<script>
    import { WebGLSceneController } from '../../script/webgl/WebGLSceneController';

    // DOMContentLoadedで初期化
    document.addEventListener('DOMContentLoaded', () => {
        const webglScene = new WebGLSceneController();
    });
</script>


<style>
    #webgl-container {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100vh;
        height: 100lvh;
        z-index: 1;
    }

    #webgl-container canvas {
        display: block;
        width: 100%;
        height: 100%;
    }
</style>
