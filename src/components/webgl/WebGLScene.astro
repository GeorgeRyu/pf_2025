---
export interface Props {
    movies?: string[];
    photos?: string[];
}
const { movies = [], photos = [] } = Astro.props;
const moviesAttr = encodeURIComponent(JSON.stringify(movies));
const photosAttr = encodeURIComponent(JSON.stringify(photos));
---

<div id="webgl-container" class="relative z-10" data-movies={moviesAttr} data-photos={photosAttr}></div>

<script>
    import { WebGLSceneController } from '../../script/webgl/WebGLSceneController';

    // DOMContentLoadedで初期化
    document.addEventListener('DOMContentLoaded', () => {
        const webglScene = new WebGLSceneController();
    });
</script>


<style>
    #webgl-container {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100vh;
        z-index: 1;
    }

    #webgl-container canvas {
        display: block;
    }
</style>
