---
import { readdir } from 'node:fs/promises';
import { fileURLToPath } from 'node:url';
import { getProjects } from '../lib/projects.js';
import WebGLScene from './webgl/WebGLScene.astro';

const projects = await getProjects();
const photosDir = fileURLToPath(new URL('../../public/images/photos', import.meta.url));
const photos = (await readdir(photosDir))
	.filter((name) => name.endsWith('.avif'))
	.map((name) => `/images/photos/${name}`);

const navItems = [
	{
		name: "Works",
		class: "",
		distanceNumber: 1
	},
	{
		name: "About",
		class: "",
		distanceNumber: 2
	},
	{
		name: "Private Projects",
		class: "pointer-events-none mt-6",
		labelClass: "opacity-30",
	},
	{
		name: "Photos",
		class: "",
		distanceNumber: 3
	},
	{
		name: "Playground",
		class: "",
		distanceNumber: 4
	}
];

const playgrounds = [
	"001 - BlackElectricFan",
	"002 - CirclingPhotos",
	"003 - working in progress",
	"004 - working in progress",
	"005 - working in progress",
	"006 - working in progress",
	"007 - working in progress"
];
---

<main class="relative bg-base">
    <WebGLScene
        movies={projects.map(p => p.movieMain)}
        playgroundMovies={[
            '/movies/playground/black-electric-fan.mp4',
            '/movies/playground/circle-pictures.mp4',
        ]}
        photos={photos}
    />

	<div
		class="fixed top-[15vh] left-0 grid grid-cols-4 gap-x-[8px] gap-y-10 w-full px-s-16-60 text-accent z-10 pointer-events-none [&_a]:pointer-events-auto [&_button]:pointer-events-auto transition-opacity lg:grid-cols-6 lg:gap-x-4 lg:gap-y-0 lg:left-0 lg:top-more-40 lg:px-s-20-60"
		:class="isPhotoActive ? 'opacity-0 pointer-events-none duration-[600ms]' : 'duration-[540ms]'"
		:inert="isPhotoActive"
	>
		<div loading-name='text' class="relative col-start-3 justify-self-start lg:hidden">
			<!-- <div class="active-nav-line absolute top-0 left-full w-[2px] h-full"></div> -->
			<div class="link-inside is-active leading-snug bg-accent/20" data-name="name-area"></div>
		</div>

		<div class="hidden lg:block col-start-5">
			<div class="grid grid-cols-1">
				{navItems.map((item) => (
					<a
						loading-name='text'
						x-on:click={`anchorLink(${item.distanceNumber}, true)`}
						href={`#${item.name.toLowerCase().replace(/\s+/g, '-')}`}
						class={`relative ${item.class} link-inside ${item.name === 'Works' ? 'is-active' : ''}`}
						data-pc-nav={item.distanceNumber ? item.name : undefined}
					>
						<div class="absolute top-0 right-[calc(100%+3px)] w-[2px] h-4/5 bg-black01 hidden"></div>
						<span class={item.labelClass}>{item.name}</span>
					</a>
				))}
			</div>
		</div>

		<div class="relative col-span-4 lg:col-span-6">
			{ /* WORKS AREA */ }
			<div data-name="works-info" class="absolute top-0 left-0 w-full h-auto grid grid-cols-4 gap-x-[8px] gap-y-8 z-10 lg:grid-cols-6 lg:gap-x-4">
				<div class="col-span-2 col-start-3 grid grid-cols-1 lg:col-start-5 lg:mt-more-60">
					{projects.map(project => (						
						<button 
							class="js-project-modal-btn link-inside text-left leading-tight cursor-pointer py-[0.3em]" 
							data-project-slug={project.slug}
							data-name="kinetic-txt"
							data-text={project.title}
							loading-name='text'
						>
							{project.title}
						</button>
					))}
				</div>
			</div>

			{ /* ABOUT AREA */ }
			<div data-name="about-area" class="absolute top-0 left-0 w-full h-auto hidden grid-cols-4 gap-x-[8px] gap-y-10 lg:top-more-60 lg:grid-cols-6 lg:gap-x-4 lg:gap-y-10">
				<p class="grid grid-cols-1 col-span-2 col-start-3 text-more-32 font-semibold -tracking-widest leading-none whitespace-nowrap lg:text-[5.3vw] lg:leading-[1.1] lg:col-start-5 lg:translate-x-[-0.065em]">
					<span class="-translate-x-[3em]" data-name="kinetic-txt">CREATE</span>
					<span class="-translate-x-[1.5em]" data-name="kinetic-txt">YOUR</span>
					<span data-name="kinetic-txt">UNIQUENESS</span>
				</p>
				<div class="grid grid-cols-1 gap-y-[0.8em] col-span-2 col-start-3 lg:grid-cols-2 lg:gap-x-4 lg:col-span-2 lg:col-start-5">
					<p data-name="kinetic-txt" class="lg:col-span-2">Designing 'individuality' and 'strength' through the process of knowing, seeing, feeling, thinking, acting, and repeating</p>
					<p data-name="kinetic-txt" class="font-jp lg:col-span-1">知る、観る、感じる、考える、手を動かす、繰り返す過程で”個性”と”強さを”をデザインし創ってゆく</p>
				</div>
			</div>

			{ /* PHOTOS AREA */ }
			<div data-name="photos-area" class="absolute top-0 left-0 gird w-full h-auto hidden grid-cols-4 gap-x-2 gap-y-[0.8em] lg:grid-cols-6">
				<p data-name="kinetic-txt" class="col-span-2 col-start-3 lg:col-start-5 lg:col-span-2 lg:mt-24">One of my hobbies is photography, and I use a FUJIFILM X-E4.</p>
				<p data-name="kinetic-txt" class="font-jp col-span-2 col-start-3 lg:col-start-5 lg:col-span-1">ふと、なんとなく良いなと思う瞬間を撮る写真が好きです。相棒はFUJIFILM X-E4</p>
				<button data-name="kinetic-txt" class="js-view-other-photos link-inside block mt-more-4 leading-snug text-left col-span-2 col-start-3 underline underline-offset-2 cursor-pointer lg:col-start-5 lg:col-span-1">view other photos</button>
			</div>

			{ /* PLAYGROUND AREA */ }
			<div data-name="playground-area" class="absolute top-0 left-0 w-full h-auto hidden grid-cols-4 gap-x-[8px] gap-y-8 lg:grid-cols-6">
				<div class="grid grid-cols-1 gap-y-[0.8em] col-span-2 col-start-3 lg:grid-cols-2 lg:gap-x-[8px] lg:col-start-5 lg:col-span-2 lg:mt-24">
					<p data-name="kinetic-txt" class="lg:col-span-2">A playground for exploring expression. Feel free to take a look</p>
					<p data-name="kinetic-txt" class="font-jp lg:col-span-1">表現を模索する遊び場。<br />よかったら覗いてみてください</p>
				</div>
				<div class="col-span-2 col-start-3 grid grid-cols-1 lg:col-start-5 lg:col-span-2">
					{playgrounds.map((playground, index) => (
						<a 
							href={`/${playground.toLowerCase().replace(/\s+/g, '-')}.html`}
							class="js-playground-link link-inside block py-[0.2em] leading-snug"
							data-name="kinetic-txt"
							data-playground-index={index}
						>
							{playground}
						</a>
					))}
				</div>
			</div>

			{ /* THX AREA */ }
			<div data-name="thx-area" class="absolute top-0 left-0 w-full h-auto hidden grid-cols-4 gap-x-[8px] gap-y-[0.8em] lg:grid-cols-6">
				<p data-name="kinetic-txt" class="col-span-2 col-start-3 lg:col-start-5 lg:col-span-2 lg:mt-24">Thank you for visiting my site. There are several gimmicks hidden throughout, so if you missed them, try looking around for them.</p>
				<p data-name="kinetic-txt" class="font-jp col-span-2 col-start-3 lg:col-start-5 lg:col-span-1">サイトを訪れてくれてありがとうございます。いくつかサイトの中にギミックがあるので、見逃してたら探してみてください</p>
			</div>
		</div>
	</div>
	{ /* MODAL CONTAINER */ }
	<div data-name="modal-container" class="hidden fixed top-0 left-0 w-full h-full z-[9999] pointer-events-none">
		<div data-name="btn-close" class="absolute left-0 bottom-0 h-[200px] w-more-24 text-more-12 bg-accent z-30 flex flex-col gap-y-3 items-center justify-center cursor-pointer pointer-events-auto lg:w-more-80 lg:h-more-24 lg:flex-row lg:gap-x-3 lg:left-auto lg:top-1/2 lg:translate-y-[-50%] lg:right-0">
			<span class="relative w-[9px] h-[9px] block pointer-events-none">
				<span class="absolute top-[4px] left-0 w-full h-[1px] bg-base rotate-45"></span>
				<span class="absolute top-[4px] left-0 w-full h-[1px] bg-base -rotate-45"></span>
			</span>
			<span class="text-more-12 text-base [writing-mode:vertical-lr] pointer-events-none lg:[writing-mode:horizontal-tb]">close</span>
		</div>

		{projects.map((project, index) => (
		<article data-name={project.slug} class="hidden absolute top-0 left-0 w-auto h-full ml-more-16 pl-more-12 bg-accent text-base font-extralight overflow-y-scroll pointer-events-auto lg:w-[calc((100vw-var(--s-20-60)*2-5rem)/6*4+3rem+var(--s-20-60))] lg:col-span-5 lg:col-start-2 lg:pt-[calc(var(--s-more-40)-2.6em)] lg:px-4 lg:ml-0">
			<div class="">
				<div class="sticky top-[0.5em] left-0 inline-block mt-[0.8em] pr-[0.2em] bg-accent lg:top-0">_{(index + 1).toString().padStart(2, '0')}</div>
				<header>
					{ project.movieMain && (
						<div class="aspect-video bg-base/25 mt-more-4">
							<video data-src={project.movieMain} muted loop playsinline preload="none" class="w-full h-auto object-cover"></video>
						</div>
					)}

					<div class="grid grid-cols-6 gap-y-[1.8em] mt-more-16 lg:gap-y-[2.6em] lg:mt-[3em]">
						<h3 class="col-span-4">{project.title}</h3>
						<ul class="grid grid-cols-1 col-span-5 col-start-2 gap-y-[0.3em] lg:row-start-2 lg:col-start-2 lg:col-span-3 lg:self-start">
							<li class="flex items-center gap-0">
								<p class="opacity-40">Role__</p>
								<p>{project.role}</p>
							</li>
							{ project.date && (
								<li class="flex items-center gap-0">
									<p class="opacity-40">Date__</p>
									<p>{project.date}</p>
								</li>
							)}
							{ project.siteClosed && (
								<li class="flex items-center gap-0">
									<p class="opacity-40">Site__</p>
									<p>Site closed</p>
								</li>
							)}
							{ !project.siteClosed && project.links?.length > 0 && (
								<li class="flex items-center gap-0">
									<p class="opacity-40">Link__</p>
									<p class="flex flex-wrap gap-x-3">
										{project.links.map((link) => (
											<a data-name="link-view-project" class="underline" href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a>
										))}
									</p>
								</li>
							)}
						</ul>
						<div class="grid grid-cols-1 col-span-4 col-start-3 gap-y-[1em] mt-0 ml-auto lg:w-auto lg:row-start-3 lg:col-start-4 lg:col-span-4">
							<p class="" set:html={project.descriptionEn}></p>
							<p class="font-jp " set:html={project.description}></p>
						</div>
					</div>
				</header>

				<div class="grid grid-cols-1 gap-y-more-24 mt-more-96 lg:mt-more-140 lg:gap-y-more-80">
					{project.blocks.map((block) => (
						<div class="bg-gray01 overflow-hidden">
							{ block.type === 'image' ? (
								<img src={block.src} alt="" class="w-full h-auto" />
							) : (
								<video data-src={block.src} muted loop playsinline preload="none" class="w-full h-auto"></video>
							)}
						</div>
					))}
					{ project.spBlocks?.length > 0 && (
						<div class="grid grid-cols-2 gap-x-more-12 lg:gap-x-more-24">
							{project.spBlocks.map((block) => (
								<div class="bg-gray01 overflow-hidden">
									{ block.type === 'image' ? (
										<img src={block.src} alt="" class="w-full h-auto" />
									) : (
										<video data-src={block.src} muted loop playsinline preload="none" class="w-full h-auto"></video>
									)}
								</div>
							))}
						</div>
					)}
				</div>

				<div class="prev-next flex justify-center items-center gap-x-more-80 h-more-200 lg:mt-more-100 lg:gap-x-more-160">
					<a href="" class="">{'< prev'}</a>
					<a href="" class="">{'next >'}</a>
				</div>
			</div>
		</article>
	))}
	</div>	
</main>

<style lang="scss" is:global>

	@keyframes link-inside-animation {
		// 0% {
		// 	opacity: 1;
		// }
		// 50% {
		// 	opacity: 0;
		// }
		0% {
			opacity: 0;
		}
		25% {
			opacity: 1;
		}
		50% {
			opacity: 0;
		}
		75% {
			opacity: 1;
		}
	}

	.link-inside {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: start;
		width: fit-content;

		&:hover,
		&.is-active {
			color: var(--c-base);
			&::before {
				opacity: 1;
				transition: opacity 0.01s linear;
				// animation: link-inside-animation 0.25s steps(6, end) forwards;
			}
		}

		&::before {
			position: absolute;
			top: 0;
			left: 0;
			content: '';
			display: block;
			width: 100%;
			height: 100%;
			background-color: var(--c-accent);
			opacity: 0;
			transition: opacity 0.6s linear;
			z-index: -1;
		}
	}

	.modal-overlay {
		position: fixed;
		top: 0;
		left: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		height: 100%;
		padding: 0 0 0 var(--s-16-60);
		z-index: 1000;
	}

	.modal-content {
		position: relative;
		width: 100%;
		height: 100%;
		// clip-path: inset(0 0 0 0%);
	}

	.modal-close {
		position: absolute;
		top: 1rem;
		right: 1rem;
		background: none;
		border: none;
		font-size: 2rem;
		cursor: pointer;
		color: #666;
	}

	#modal-container {
		// display: none;
	}
</style>